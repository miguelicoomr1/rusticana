---
import Photo from './Photo.astro';
import { t, pathFor, type Locale } from '../i18n/index.ts';
import type { PhotoKey } from '../data/photos.ts';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const shots: PhotoKey[] = ['terraceEvening', 'dishPaella', 'playground', 'dishScallops'];
---

<section class="strip section--tight" aria-labelledby="strip-title">
  <div class="wrap">
    <div class="strip__head reveal">
      <h2 id="strip-title" class="h-2">{t(locale, 'galleryPage.title')}</h2>
      <a class="text-link" href={pathFor(locale, 'gallery')}>{t(locale, 'cta.gallery')}</a>
    </div>
    <ul class="strip__list" role="list">
      {
        shots.map((k, i) => (
          <li class="reveal" style={`--reveal-delay: ${i * 0.07}s`}>
            <a href={pathFor(locale, 'gallery')} tabindex="-1" aria-hidden="true">
              <Photo photo={k} locale={locale} sizes="(min-width: 64em) 22vw, 46vw" widths={[320, 480, 640]} alt="" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .strip {
    padding-block: calc(var(--section) * 0.7);
  }
  .strip__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }
  .strip__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .strip__list :global(img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 2px;
    transition:
      transform 0.9s var(--ease-out),
      filter 0.6s;
  }
  .strip__list li {
    overflow: hidden;
    border-radius: 2px;
  }
  .strip__list li:hover :global(img) {
    transform: scale(1.06);
  }
  .strip__list li:nth-child(even) {
    margin-top: 1.5rem;
  }
  @media (min-width: 48em) {
    .strip__list {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }
</style>
