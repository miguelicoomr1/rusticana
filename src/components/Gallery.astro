---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { galleryItems, type GalleryCategory } from '../data/gallery.ts';
import { photos } from '../data/photos.ts';
import { t, type Locale } from '../i18n/index.ts';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const showSlots = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_PHOTO_SLOTS === 'true';
const items = galleryItems.filter((i) => i.photo || showSlots);
const cats = [...new Set(items.map((i) => i.category))] as GalleryCategory[];
const full = new Map<string, string>();
for (const it of items) {
  if (it.photo) full.set(it.id, (await getImage({ src: photos[it.photo], width: 1600, format: 'webp', quality: 78 })).src);
}
const real = items.filter((i) => i.photo);
---

<section class="gal section--tight" aria-label={t(locale, 'galleryPage.title')}>
  <div class="wrap">
    <div class="gal__filters" role="group" aria-label={t(locale, 'galleryPage.filterLabel')} data-gal-filters>
      <button type="button" class="chip" aria-pressed="true" data-filter="all">{t(locale, 'galleryPage.all')}</button>
      {cats.map((c) => <button type="button" class="chip" aria-pressed="false" data-filter={c}>{t(locale, `galleryPage.categories.${c}`)}</button>)}
    </div>

    <ul class="gal__grid" role="list">
      {
        items.map((it) => {
          const idx = real.findIndex((r) => r.id === it.id);
          return (
            <li class={`gal__item gal__item--${it.shape}`} data-cat={it.category}>
              {it.photo ? (
                <button
                  type="button"
                  class="gal__open"
                  data-full={full.get(it.id)}
                  data-alt={t(locale, `photos.${it.photo}`)}
                  data-index={idx}
                  aria-haspopup="dialog"
                >
                  <Photo photo={it.photo} locale={locale} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 92vw" widths={[480, 768, 1024]} />
                  <span class="gal__tag">{t(locale, `galleryPage.categories.${it.category}`)}</span>
                </button>
              ) : (
                <div class="gal__slot">
                  <Icon name="sun" class="gal__slot-icon" />
                  <p class="gal__slot-title">{t(locale, 'galleryPage.pendingTitle')}</p>
                  <p class="gal__slot-brief">{it.brief}</p>
                  <p class="gal__slot-hint">{t(locale, 'galleryPage.pendingHint')}</p>
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
    <p class="gal__note muted">{t(locale, 'galleryPage.note')}</p>
  </div>
</section>

<dialog class="lightbox on-olive" data-lightbox aria-label={t(locale, 'galleryPage.lightbox.label')}>
  <div class="lightbox__bar">
    <p class="lightbox__count tabular" data-lb-count aria-live="polite"></p>
    <button type="button" class="lightbox__btn" data-lb-close aria-label={t(locale, 'galleryPage.lightbox.close')}><Icon name="close" /></button>
  </div>
  <figure class="lightbox__fig">
    <img alt="" width="1600" height="1200" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lb-img />
    <figcaption data-lb-caption></figcaption>
  </figure>
  <button type="button" class="lightbox__btn lightbox__prev" data-lb-prev aria-label={t(locale, 'galleryPage.lightbox.prev')}>
    <Icon name="arrow" class="flip" />
  </button>
  <button type="button" class="lightbox__btn lightbox__next" data-lb-next aria-label={t(locale, 'galleryPage.lightbox.next')}>
    <Icon name="arrow" />
  </button>
</dialog>

<script is:inline define:vars={{ counterTpl: t(locale, 'galleryPage.lightbox.counter') }}>
  window.__lbCounter = counterTpl;
</script>
<script>
  import '../scripts/gallery.ts';
</script>

<style>
  .gal__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .chip {
    min-height: 2.75rem;
    padding: 0.4rem 1.1rem;
    border: 1.5px solid var(--olive-800);
    border-radius: 999px;
    background: transparent;
    font-weight: 650;
    font-size: var(--fs-sm);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .chip:hover {
    background: var(--straw-deep);
  }
  .chip[aria-pressed='true'] {
    background: var(--olive-800);
    color: var(--straw);
  }
  .gal__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    grid-auto-rows: 9rem;
    gap: 0.75rem;
  }
  .gal__item {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    min-height: 0;
  }
  .gal__item[hidden] {
    display: none;
  }
  .gal__item--wide {
    grid-column: span 2;
    grid-row: span 2;
  }
  .gal__item--tall {
    grid-row: span 3;
  }
  .gal__item--square {
    grid-row: span 2;
  }
  .gal__open {
    all: unset;
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
    position: relative;
  }
  .gal__open:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  .gal__open :global(picture),
  .gal__open :global(img) {
    width: 100%;
    height: 100%;
  }
  .gal__open :global(img) {
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .gal__open:hover :global(img) {
    transform: scale(1.05);
  }
  .gal__tag {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.65rem;
    background: var(--olive-800);
    color: var(--straw);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease-out);
  }
  .gal__open:hover .gal__tag,
  .gal__open:focus-visible .gal__tag {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .gal__tag {
      opacity: 1;
      transform: none;
    }
  }
  .gal__slot {
    height: 100%;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    background: var(--straw-deep);
    border: 1.5px dashed var(--esparto-deep);
    border-radius: 2px;
  }
  .gal__slot-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--olive-600);
  }
  .gal__slot-title {
    font-weight: 750;
    font-size: var(--fs-sm);
  }
  .gal__slot-brief {
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .gal__slot-hint {
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }
  .gal__note {
    margin-top: 2rem;
    font-size: var(--fs-sm);
    max-width: 60ch;
  }
  @media (min-width: 40em) {
    .gal__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 11rem;
      gap: 1rem;
    }
    .gal__item--wide {
      grid-column: span 2;
    }
  }
  @media (min-width: 64em) {
    .gal__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 12rem;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--olive-950) 96%, transparent);
    color: var(--straw);
    overflow: hidden;
  }
  .lightbox:not([open]) {
    display: none;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
    animation: lb-in 0.35s var(--ease-out);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox::backdrop {
    background: var(--olive-950);
  }
  .lightbox__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
  }
  .lightbox__fig {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.75rem;
    padding: 0 3.5rem 1rem;
    justify-items: center;
  }
  .lightbox__fig img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    min-height: 0;
  }
  .lightbox__fig figcaption {
    font-size: var(--fs-sm);
    color: var(--on-olive-muted);
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: transparent;
    border: 1.5px solid var(--rule);
    color: var(--straw);
    border-radius: 2px;
  }
  .lightbox__btn:hover {
    background: color-mix(in srgb, var(--straw) 14%, transparent);
    border-color: var(--straw);
  }
  .lightbox__prev,
  .lightbox__next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__prev {
    left: 0.5rem;
  }
  .lightbox__next {
    right: 0.5rem;
  }
  .lightbox :global(.flip) {
    transform: scaleX(-1);
  }
  body:has(dialog[open]) {
    overflow: hidden;
  }
</style>
