---
import Photo from './Photo.astro';
import { restaurant } from '../config/restaurant.config.ts';
import { t, pathFor, type Locale } from '../i18n/index.ts';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Photo photo="terraceEvening" locale={locale} eager sizes="100vw" widths={[420, 640, 900, 1280]} quality={55} />
  </div>

  <div class="hero__panel on-olive">
    <div class="plait plait--thin hero__plait" aria-hidden="true"></div>
    <div class="hero__body">
      <h1 id="hero-title" class="h-display hero__title">
        <span class="sr-only">{t(locale, 'hero.srPrefix')} </span>{restaurant.name}
      </h1>
      <p class="hero__lead">{t(locale, 'hero.lead')}</p>
      <div class="hero__cta">
        <a class="btn" href={pathFor(locale, 'reservations')} data-track="reserve-hero">{t(locale, 'cta.reserveTable')}</a>
        <a class="btn btn--ghost" href={pathFor(locale, 'menu')}>{t(locale, 'cta.viewMenu')}</a>
      </div>
      <p class="hero__place">{t(locale, 'hero.place')}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    background: var(--olive-900);
    overflow: clip;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero__media :global(img) {
    object-fit: cover;
    object-position: 62% 60%;
    transform-origin: 50% 60%;
    animation: hero-settle 2.6s var(--ease-out) both;
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  /* parallax de una sola vía, sin JS, solo donde el navegador lo soporta */
  @supports (animation-timeline: scroll()) {
    .hero__media {
      animation: hero-drift linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 100svh;
    }
    @keyframes hero-drift {
      to {
        transform: translateY(7%);
      }
    }
  }

  /* móvil/tablet: foto completa arriba, panel debajo (así se ve la terraza, no solo una sombrilla) */
  @media (max-width: 63.99em) {
    .hero {
      display: block;
      min-height: 100svh;
    }
    .hero__media {
      position: relative;
      inset: auto;
      z-index: 0;
      height: clamp(18rem, 46svh, 34rem);
      margin-top: var(--header-h);
    }
    .hero__media :global(img) {
      object-position: 60% 62%;
    }
    .hero .hero__panel {
      width: 100%;
    }
  }

  .hero__panel {
    --hero-pl: max(var(--gutter), calc((100vw - var(--page)) / 2 + var(--gutter)));
    position: relative;
    width: min(100%, calc(var(--hero-pl) + 41rem));
    padding-top: 0;
  }
  /* escritorio: cartel translúcido, la terraza se ve a través */
  @media (min-width: 64em) {
    .hero .hero__panel {
      background: color-mix(in srgb, var(--olive-900) 52%, transparent);
      -webkit-backdrop-filter: blur(3px) saturate(1.1);
      backdrop-filter: blur(3px) saturate(1.1);
      text-shadow: 0 1px 14px rgb(0 0 0 / 0.45);
    }
  }
  .hero__plait {
    width: 100%;
  }
  .hero__body {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem) var(--gutter) calc(clamp(1.75rem, 1rem + 2.5vw, 3rem) + 1.5rem);
    padding-left: var(--hero-pl);
    display: grid;
    gap: 1.1rem;
  }
  @media (min-width: 64em) {
    .hero__body {
      padding-bottom: clamp(1.75rem, 1rem + 2.5vw, 3rem);
      padding-right: 3rem;
    }
  }
  .hero__title {
    letter-spacing: -0.02em;
  }
  .hero__lead {
    font-size: var(--fs-1);
    line-height: 1.45;
    max-width: 32ch;
    color: var(--on-olive);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero__place {
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-sm);
    letter-spacing: 0.06em;
    color: var(--on-olive-muted);
  }
  .hero .btn--ghost {
    --btn-fg: var(--straw);
  }
  .hero .btn--ghost:hover {
    --btn-bg: var(--straw);
    --btn-fg: var(--olive-900);
    --btn-bd: var(--straw);
  }

  /* entrada: solo lo secundario (el H1 y la foto son el LCP y nunca esperan) */
  .hero__lead,
  .hero__cta,
  .hero__place {
    animation: hero-rise 1.1s var(--ease-out) both;
  }
  .hero__lead {
    animation-delay: 0.15s;
  }
  .hero__cta {
    animation-delay: 0.3s;
  }
  .hero__place {
    animation-delay: 0.45s;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media,
    .hero__media :global(img),
    .hero__lead,
    .hero__cta,
    .hero__place {
      animation: none;
    }
  }
</style>
