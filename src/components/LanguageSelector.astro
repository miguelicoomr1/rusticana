---
import { LOCALES, LOCALE_META, pathFor, t, type Locale, type PageKey } from '../i18n/index.ts';
interface Props {
  locale: Locale;
  pageKey: PageKey;
  /** 'header' = desplegable compacto; 'inline' = lista visible (menú móvil / footer) */
  variant?: 'header' | 'inline';
}
const { locale, pageKey, variant = 'header' } = Astro.props;
const items = LOCALES.map((l) => ({ ...LOCALE_META[l], href: pathFor(l, pageKey), current: l === locale }));
const current = LOCALE_META[locale];
---

{
  variant === 'header' ? (
    <details class="lang" data-lang-menu>
      <summary class="lang__button" aria-label={t(locale, 'nav.language')}>
        <span class="lang__code" aria-hidden="true">
          {current.short}
        </span>
        <span class="lang__name">{current.nativeName}</span>
        <svg class="lang__chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ul class="lang__list" role="list">
        {items.map((it) => (
          <li>
            <a href={it.href} hreflang={it.hreflang} lang={it.hreflang} data-lang-link={it.code} aria-current={it.current ? 'true' : undefined}>
              <span class="lang__code" aria-hidden="true">
                {it.short}
              </span>
              <span>{it.nativeName}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <ul class="lang-inline" role="list" aria-label={t(locale, 'nav.language')}>
      {items.map((it) => (
        <li>
          <a href={it.href} hreflang={it.hreflang} lang={it.hreflang} data-lang-link={it.code} aria-current={it.current ? 'true' : undefined}>
            <span class="lang__code" aria-hidden="true">
              {it.short}
            </span>
            <span>{it.nativeName}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .lang {
    position: relative;
  }
  .lang__button {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem clamp(0.5rem, 0.3rem + 1vw, 0.75rem);
    border: 1.5px solid currentColor;
    border-radius: 2px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    user-select: none;
    transition: background-color 0.2s var(--ease-out);
  }
  .lang__button::-webkit-details-marker {
    display: none;
  }
  .lang__button:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .lang__code {
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .lang__name {
    display: none;
    font-weight: 500;
    letter-spacing: 0;
  }
  @media (min-width: 64em) {
    .lang__name {
      display: inline;
    }
  }
  .lang__chev {
    transition: transform 0.3s var(--ease-out);
  }
  .lang[open] .lang__chev {
    transform: rotate(180deg);
  }
  .lang__list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 13.5rem;
    background: var(--straw);
    color: var(--ink);
    border: 1.5px solid var(--olive-800);
    border-radius: 2px;
    padding: 0.35rem;
    z-index: 60;
    transform-origin: top right;
    animation: lang-in 0.32s var(--ease-out);
  }
  @keyframes lang-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  .lang__list a,
  .lang-inline a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
    border-radius: 2px;
  }
  .lang__list a:hover {
    background: var(--straw-deep);
  }
  .lang__list a[aria-current='true'] {
    background: var(--olive-800);
    color: var(--straw);
  }
  .lang__list .lang__code {
    width: 1.75rem;
    font-size: 0.8125rem;
  }
  .lang-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lang-inline a {
    border: 1.5px solid var(--rule);
    padding: 0.4rem 0.85rem;
    gap: 0.6rem;
    font-size: 0.9375rem;
  }
  .lang-inline a:hover {
    border-color: currentColor;
  }
  .lang-inline a[aria-current='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .lang-inline .lang__code {
    font-size: 0.8125rem;
  }
</style>
