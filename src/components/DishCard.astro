---
import { formatPrice, localized, type MenuItem } from '../lib/menu.ts';
import { t, type Locale } from '../i18n/index.ts';
interface Props {
  item: MenuItem;
  locale: Locale;
}
const { item, locale } = Astro.props;
const tr = locale === 'es' ? '' : localized(item.tr, locale);
const desc = localized(item.desc, locale);
const price = item.priceText ?? (item.price != null ? formatPrice(item.price, locale) : '');
const tags = item.tags ?? [];
---

<li class="dish-row" data-tags={tags.join(' ')} id={`dish-${item.id}`}>
  <div class="dish-row__main">
    <h3 class="dish-row__name">{item.name}</h3>
    {tr && <p class="dish-row__tr">{tr}</p>}
    {desc && <p class="dish-row__desc">{desc}</p>}
    {tags.length > 0 && <ul class="dish-row__tags" role="list">{tags.map((tag) => <li>{t(locale, `menuPage.tags.${tag}`)}</li>)}</ul>}
  </div>
  <span class="dish-row__dots" aria-hidden="true"></span>
  <p class="dish-row__price tabular">
    {price || <span class="dish-row__ask">{t(locale, 'menuPage.askStaff')}</span>}
    {item.unit && price && <small> / {t(locale, 'menuPage.perUnit')}</small>}
  </p>
</li>

<style>
  .dish-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 0.95rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.3s var(--ease-out);
  }
  .dish-row:hover {
    background: color-mix(in srgb, var(--esparto) 22%, transparent);
  }
  .dish-row__main {
    transition: transform 0.3s var(--ease-out);
  }
  .dish-row:hover .dish-row__main {
    transform: translateX(0.4rem);
  }
  .dish-row__dots {
    display: none;
  }
  .dish-row__name {
    font-family: var(--font-text);
    font-weight: 650;
    font-size: var(--fs-0);
    letter-spacing: 0;
    line-height: 1.3;
  }
  .dish-row__tr {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    margin-top: 0.1rem;
  }
  .dish-row__desc {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    margin-top: 0.2rem;
    max-width: 52ch;
  }
  .dish-row__price {
    font-weight: 700;
    white-space: nowrap;
    text-align: right;
  }
  .dish-row__price small {
    font-weight: 500;
    color: var(--fg-muted);
  }
  .dish-row__ask {
    font-weight: 500;
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }
  .dish-row__tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.35rem;
    flex-wrap: wrap;
  }
  .dish-row__tags li {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--olive-600);
    color: var(--olive-700);
    border-radius: 999px;
  }
</style>
