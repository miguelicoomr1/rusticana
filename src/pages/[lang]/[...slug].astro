---
import { LOCALES, PAGE_KEYS, SLUGS, type Locale, type PageKey } from '../../i18n/index.ts';
import HomeView from '../../views/HomeView.astro';
import MenuView from '../../views/MenuView.astro';
import AboutView from '../../views/AboutView.astro';
import GalleryView from '../../views/GalleryView.astro';
import ReservationsView from '../../views/ReservationsView.astro';
import ContactView from '../../views/ContactView.astro';
import LegalView from '../../views/LegalView.astro';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    PAGE_KEYS.map((key) => ({
      params: { lang, slug: SLUGS[key][lang] || undefined },
      props: { locale: lang as Locale, key: key as PageKey },
    })),
  );
}
const { locale, key } = Astro.props;
---

{key === 'home' && <HomeView locale={locale} />}
{key === 'menu' && <MenuView locale={locale} />}
{key === 'about' && <AboutView locale={locale} />}
{key === 'gallery' && <GalleryView locale={locale} />}
{key === 'reservations' && <ReservationsView locale={locale} />}
{key === 'contact' && <ContactView locale={locale} />}
{(key === 'legal' || key === 'privacy' || key === 'cookies') && <LegalView locale={locale} pageKey={key} />}
