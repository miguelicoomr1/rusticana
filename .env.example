# Dominio público definitivo (canonical, hreflang, sitemap, Open Graph). Sin barra final.
PUBLIC_SITE_URL=https://larusticana.example

# Google Analytics 4 (opcional). Solo se carga tras consentimiento del usuario. Ej: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Search Console: contenido del meta google-site-verification (opcional)
PUBLIC_GSC_VERIFICATION=

# Endpoint del sistema de reservas (opcional). Si está vacío el formulario abre WhatsApp / correo con los datos.
# Debe aceptar POST application/json con: name, phone, email, date, time, guests, area, notes, allergies, locale
PUBLIC_RESERVATION_ENDPOINT=

# URL del iframe/mapa embebido de Google (opcional). Si está vacío se usa un mapa propio con enlace a Google Maps.
PUBLIC_MAPS_EMBED_URL=
