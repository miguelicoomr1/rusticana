{
  "name": "la-rusticana-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio web multilingüe de Restaurante La Rusticana (Atamaría / La Manga Club, Cartagena).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify": "node scripts/verify-dist.mjs",
    "qa": "npm run lint && npm run test && npm run build && npm run verify"
  },
  "dependencies": {
    "@fontsource-variable/brygada-1918": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.5.0",
    "lighthouse": "^13.5.0",
    "lucide-static": "^1.47.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "simple-icons": "^16.32.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
